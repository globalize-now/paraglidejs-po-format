{
  "name": "@globalize-now/paraglidejs-po-format",
  "version": "0.1.0",
  "description": "inlang/Paraglide JS plugin to use gettext PO files as translation inputs.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "inlang",
    "paraglide",
    "i18n",
    "localization",
    "gettext",
    "po",
    "po-format"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.js && tsc --emitDeclarationOnly",
    "dev": "node build.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,json,md}\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json,md}\" \"*.{js,ts,json,md}\""
  },
  "dependencies": {
    "gettext-parser": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@inlang/sdk": "^2.9.3",
    "@sinclair/typebox": "^0.31.17",
    "@types/gettext-parser": "^9.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
